# OpenRouter key (https://openrouter.ai/keys). Copy this file to .env.local; only the dev server reads it.
# The server routes each question: Sonnet 5.5 for analysis, Haiku 5.5 for simple lookups.
OPENROUTER_API_KEY=
# Exa public professional-background research for Ask the graph. Server-side only.
EXA_API_KEY=
# Neon Postgres connection string for stored AI reads and headline history; then run npm run db:migrate.
DATABASE_URL=
# Created by scripts/publish_knowledge_neon.py: SELECT-only access to alphacouncil_graph.
# Keep this unprefixed; it is only read by the Vite server, never the browser bundle.
KNOWLEDGE_DATABASE_URL=
# True Markets trading: path to your downloaded API key file (save it with npm run tm:key).
TM_KEY_FILE=
# Live orders are refused unless this is exactly "true". Previews and the portfolio work either way.
TM_TRADING_ENABLED=false
# Server-enforced limits (USD): per order, and rolling 24 hours.
TM_MAX_ORDER_USD=10
TM_DAILY_LIMIT_USD=25
