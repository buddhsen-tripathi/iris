  "lightgbm_learning_rate": 0.03,
  "lightgbm_min_child_samples": 200,
  "lightgbm_reg_lambda": 10.0,
  "kalman_process_to_observation_ratios": [0.0001, 0.001],
  "statistical_coefficient_bounds": [0.0, 1.0],
  "ensemble": {"lightgbm": 0.2, "ridge": 0.2, "kalman": 0.2, "mean_reversion": 0.2, "momentum": 0.2},
  "paper": {
