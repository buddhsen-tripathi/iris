{
  "version": "btc-5-15-30-v1",
  "horizons_minutes": [5, 15, 30],
  "seed": 20261024,
  "initial_training_days": 240,
  "model_selection_days": 35,
  "reserved_final_days": 30,
  "common_warmup_days": 2,
  "features": [
    "return_5m", "return_30m", "price_z_48", "realized_vol_48", "vol_ratio_12_48",
