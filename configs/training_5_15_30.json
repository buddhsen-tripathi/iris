    "cost_scenarios": [
      {"name": "zero_cost_diagnostic", "fee_bps_per_side": 0.0, "impact_bps_per_side": 0.0},
      {"name": "12bps_round_trip", "fee_bps_per_side": 5.0, "impact_bps_per_side": 1.0},
      {"name": "24bps_round_trip_base", "fee_bps_per_side": 10.0, "impact_bps_per_side": 2.0},
      {"name": "40bps_round_trip", "fee_bps_per_side": 15.0, "impact_bps_per_side": 5.0}
    ]
  }
